<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Shop Radar picture service on the iMac. Install: see radar/shots/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>co.bookease.radar-shots</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/sb/Projects/bookease-tools/radar/shots/watch.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sb/Projects/bookease-tools</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/sb/Library/Logs/radar-shots.log</string>
  <key>StandardErrorPath</key><string>/Users/sb/Library/Logs/radar-shots.log</string>
</dict>
</plist>
